#!/usr/bin/env python3

import os
import subprocess
import sys

EXTENSION_SOURCES = (
    "npm:", "file:", "github:", "git:", "http:", "https:",
    "./", "../", "~/", "/",
)
PATH_PREFIXES = ("/", "./", "../", "~/")

# Package-name fragments excluded from the local profile.
# Match against the source shown by `pi list` or its resolved filesystem path.
BLOCKED_FOR_LOCAL = ["pi-ssh-remote-autocomplete-fix", "pi-ssh-remote"]

# Package-name fragments excluded from the remote profile.
# The sandbox extension is intended for the local profile only.
BLOCKED_FOR_REMOTE = ["pi-sandbox"]


def usage() -> None:
    print(
        "Usage: pi-profile [--show] {local|remote} [pi args...]",
        file=sys.stderr,
    )


def supports_color() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("CLICOLOR_FORCE"):
        return True
    return sys.stdout.isatty()


def unicode_marks() -> tuple[str, str] | None:
    if os.environ.get("PI_PROFILE_ASCII"):
        return None

    marks = ("✓", "✗")
    encoding = sys.stdout.encoding or "utf-8"

    try:
        for mark in marks:
            mark.encode(encoding)
    except UnicodeEncodeError:
        return None

    return marks


def get_extensions() -> list[tuple[str, str]]:
    result = subprocess.run(
        ["pi", "list"],
        check=True,
        text=True,
        capture_output=True,
    )

    extensions: list[tuple[str, str]] = []
    seen_paths: set[str] = set()
    source: str | None = None

    for line in result.stdout.splitlines():
        line = line.strip()

        # A package source can itself be a path. Consume its resolved path
        # before checking whether the next line starts a new source.
        if source and line.startswith(PATH_PREFIXES):
            path = os.path.expanduser(line)
            canonical_path = os.path.realpath(path)
            if canonical_path not in seen_paths:
                extensions.append((source, path))
                seen_paths.add(canonical_path)
            source = None
            continue

        source = line if line.startswith(EXTENSION_SOURCES) else None

    return extensions


def should_load(mode: str, source: str, path: str) -> bool:
    extension = f"{source} {path}"

    blocked = {"local": BLOCKED_FOR_LOCAL, "remote": BLOCKED_FOR_REMOTE}[mode]
    return not any(name in extension for name in blocked)


def show_extensions(
    mode: str,
    extensions: list[tuple[str, str]],
) -> None:
    color = supports_color()
    marks = unicode_marks()

    green = "\033[1;32m" if color else ""
    red = "\033[1;31m" if color else ""
    dim = "\033[2m" if color else ""
    reset = "\033[0m" if color else ""

    print("Found extensions:")

    for source, path in extensions:
        use = should_load(mode, source, path)

        if marks:
            yes, no = marks
            status = f"{yes} USE" if use else f"{no} SKIP"
        else:
            status = "USE " if use else "SKIP"

        tint = green if use else red

        print(f"  [{tint}{status}{reset}] {source}")
        print(f"         {dim}{path}{reset}")


def main() -> None:
    args = sys.argv[1:]
    show = bool(args and args[0] == "--show")
    if show:
        args = args[1:]

    if not args or args[0] not in {"local", "remote"}:
        usage()
        raise SystemExit(2)

    mode = args[0]
    pi_args = args[1:]
    extensions = get_extensions()

    if show:
        show_extensions(mode, extensions)
        return

    args = ["pi", "--no-extensions"]

    for source, path in extensions:
        if should_load(mode, source, path):
            args.extend(["-e", path])

    os.execvp("pi", [*args, *pi_args])


if __name__ == "__main__":
    main()


